---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Devanshu Jain — Staff Software Engineer, Machine Learning | Google Cloud',
  description = 'Personal portfolio of Devanshu Jain — Staff Machine Learning Engineer at Google Cloud (LLM Inference on TPUs) & former YouTube Recommendations Tech Lead. UPenn MSE CIS.'
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://devanshujain.dev');

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Devanshu Jain',
  url: 'https://devanshujain.dev',
  image: 'https://devanshujain.dev/profile.jpg',
  jobTitle: 'Staff Software Engineer, Machine Learning',
  worksFor: {
    '@type': 'Organization',
    name: 'Google Cloud'
  },
  alumniOf: [
    {
      '@type': 'CollegeOrUniversity',
      name: 'University of Pennsylvania'
    },
    {
      '@type': 'CollegeOrUniversity',
      name: 'Dhirubhai Ambani University'
    }
  ],
  sameAs: [
    'https://www.linkedin.com/in/jndevanshu/',
    'https://github.com/jndevanshu',
    'https://scholar.google.com/citations?user=vVnK7c8AAAAJ'
  ]
};
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Devanshu Jain" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="sitemap" href="/sitemap.xml" />

    <!-- OpenGraph / Social Meta -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://devanshujain.dev/profile.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://devanshujain.dev/profile.jpg" />

    <!-- Schema.org JSON-LD for Google Knowledge Graph & Search Indexing -->
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts: Newsreader (Editorial Serif), Plus Jakarta Sans (Clean UI), JetBrains Mono (Technical) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,400;0,500;0,600;1,400&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- KaTeX stylesheet for LaTeX math in blog posts -->
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.11/dist/katex.min.css"
      crossorigin="anonymous"
    />
  </head>
  <body class="bg-paper text-ink font-sans antialiased selection:bg-accent/15 selection:text-accent min-h-screen flex flex-col">
    <slot />
  </body>
</html>

<style is:global>
  /* Subtle academic paper grid & refined scrollbars */
  html {
    scroll-padding-top: 5rem;
  }

  body {
    background-color: #FAF9F6;
    color: #111827;
    font-feature-settings: "cv02", "cv03", "cv04", "cv11";
  }

  /* Custom subtle rule styling */
  .editorial-rule {
    border-top: 1px solid #E5E7EB;
  }
</style>
