---
import { portfolioData } from '../data/portfolio';

const { experience } = portfolioData;
---

<section id="experience" class="py-14 sm:py-20 border-b border-border">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <!-- Section Header -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-10 sm:mb-12 gap-2">
      <div>
        <span class="font-mono text-xs uppercase tracking-widest text-accent font-semibold">
          01 / Career Trajectory
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-medium text-ink mt-1 tracking-tight">
          Industry Experience
        </h2>
      </div>
      <p class="text-sm text-ink-subtle font-mono">
        Google Cloud · YouTube · Uber · Amazon
      </p>
    </div>

    <!-- Experience Entries -->
    <div class="space-y-6 sm:space-y-8">
      {experience.map((job) => (
        <article class="group relative grid grid-cols-1 md:grid-cols-12 gap-3 md:gap-8 pb-6 sm:pb-8 border-b border-border last:border-b-0 last:pb-0 items-start">
          <!-- Left Column: Company, Dates, Location -->
          <div class="md:col-span-4">
            <div class="flex items-center gap-2">
              <h3 class="font-serif text-2xl font-medium text-ink">
                {job.company}
              </h3>
              {job.current && (
                <span class="px-2 py-0.5 text-[11px] font-mono font-medium bg-accent-light text-accent border border-accent-border rounded-full">
                  Current
                </span>
              )}
            </div>
            <p class="font-mono text-xs text-ink-subtle mt-1">
              {job.period}
            </p>
            <p class="text-xs text-ink-subtle mt-0.5">
              {job.location}
            </p>
          </div>

          <!-- Right Column: Role Title, Domain & One-Liner Description -->
          <div class="md:col-span-8">
            <div class="bg-surface border border-border rounded-xl p-5 sm:p-6 shadow-[0_1px_2px_rgba(0,0,0,0.02)]">
              <div class="border-b border-border pb-3 mb-3">
                <h4 class="text-base sm:text-lg font-semibold text-ink leading-snug">
                  {job.role}
                </h4>
                <p class="font-mono text-xs text-accent mt-0.5">
                  {job.domain}
                </p>
              </div>

              <p class="text-sm sm:text-[15.5px] text-ink-muted leading-relaxed">
                {job.description}
              </p>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
