---
import { portfolioData } from '../data/portfolio';

const { profile, socials } = portfolioData;
---

<footer id="contact" class="py-16 sm:py-24 bg-surface">
  <div class="max-w-5xl mx-auto px-5 sm:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start pb-14 border-b border-border">
      <!-- Left Column: Call to Action -->
      <div class="lg:col-span-7">
        <span class="font-mono text-xs uppercase tracking-widest text-accent font-semibold">
          06 / Connect & Collaborate
        </span>
        <h2 class="font-serif text-3xl sm:text-4xl font-medium text-ink mt-1 tracking-tight">
          Get in Touch
        </h2>
        <p class="mt-3 text-base text-ink-muted leading-relaxed max-w-xl">
          Whether you want to discuss large-scale LLM inference on TPUs, recommender systems architecture, research collaborations, or engineering opportunities, feel free to reach out via email or connect on LinkedIn.
        </p>

        <!-- Resume Notice -->
        <div class="mt-6">
          <div class="inline-flex items-center gap-2 px-4 py-2.5 rounded-lg bg-paper border border-border text-xs font-mono font-medium text-ink">
            <span>📄</span>
            <span>Full resume available upon request</span>
          </div>
        </div>
      </div>

      <!-- Right Column: Social & Email Directory Cards -->
      <div class="lg:col-span-5 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-1 gap-3">
        <a
          href={`mailto:${profile.email}`}
          class="group flex items-center justify-between p-4 rounded-xl bg-paper border border-border hover:border-ink/40 transition-all"
        >
          <div>
            <div class="text-xs font-mono uppercase tracking-wider text-ink-subtle">
              Email
            </div>
            <div class="text-sm font-medium text-ink group-hover:text-accent transition-colors mt-0.5">
              {profile.email}
            </div>
          </div>
          <span class="font-mono text-sm text-ink-subtle group-hover:text-accent group-hover:translate-x-0.5 transition-all">
            ✉
          </span>
        </a>
        {socials.map((social) => (
          <a
            href={social.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group flex items-center justify-between p-4 rounded-xl bg-paper border border-border hover:border-ink/40 transition-all"
          >
            <div>
              <div class="text-xs font-mono uppercase tracking-wider text-ink-subtle">
                {social.name}
              </div>
              <div class="text-sm font-medium text-ink group-hover:text-accent transition-colors mt-0.5">
                {social.label}
              </div>
            </div>
            <span class="font-mono text-sm text-ink-subtle group-hover:text-accent group-hover:translate-x-0.5 transition-all">
              ↗
            </span>
          </a>
        ))}
      </div>
    </div>

    <!-- Bottom Colophon -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-ink-subtle font-mono">
      <div>
        © {new Date().getFullYear()} {profile.name}
      </div>
      <div class="flex items-center gap-4">
        <a href="/#bio" class="hover:text-ink transition-colors">Top ↑</a>
      </div>
    </div>
  </div>
</footer>
